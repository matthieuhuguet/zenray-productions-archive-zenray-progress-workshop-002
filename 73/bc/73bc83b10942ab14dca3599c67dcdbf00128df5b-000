## (b) Ajouts à `theme.js`

Coller à la fin du fichier (après `glassPanel`). Ces helpers donnent un style inline cohérent pour les composants qui prennent `style={}` (TypedCell, menus dynamiques), en miroir des classes CSS.

```js
// ── Helpers boutons cohérents (miroir des classes .zr-btn*) pour usage inline ──
// variant: 'primary' | 'secondary' | 'ghost'. size: 'md' | 'sm'.
export const btn = (t, variant = 'secondary', size = 'md') => {
  const base = {
    display: 'inline-flex', alignItems: 'center', justifyContent: 'center', gap: 6,
    fontFamily: "'AnthropicSans', sans-serif", fontWeight: 600, lineHeight: 1,
    border: 'none', cursor: 'pointer', whiteSpace: 'nowrap', userSelect: 'none',
    borderRadius: size === 'sm' ? 'var(--zr-r-chip)' : 'var(--zr-r-control)',
    padding: size === 'sm' ? '5px 11px' : '8px 16px',
    fontSize: size === 'sm' ? 12 : 13,
    transition: 'transform .12s ease, box-shadow .12s ease, background .12s ease, filter .12s ease',
  }
  if (variant === 'primary') return { ...base, background: PALETTE.gradient, color: '#fff', boxShadow: 'var(--zr-edge-top), 0 2px 8px rgba(226,118,135,0.32)' }
  if (variant === 'ghost') return { ...base, background: 'transparent', color: t.textSecondary, fontWeight: 500 }
  return { ...base, background: 'var(--zr-glass-bg-strong)', color: t.textPrimary, backdropFilter: 'blur(12px) saturate(160%)', WebkitBackdropFilter: 'blur(12px) saturate(160%)', boxShadow: 'var(--zr-edge-ring), 0 1px 3px rgba(0,0,0,0.10)' }
}

// Carte flottante en verre (Board, Gallery, KPI), pendant inline de .zr-card.
export const card = (t, { hover = false } = {}) => ({
  background: (t.glass && t.glass.bgStrong) || 'rgba(255,255,255,0.86)',
  borderRadius: 'var(--zr-r-panel)',
  backdropFilter: 'blur(20px) saturate(180%)', WebkitBackdropFilter: 'blur(20px) saturate(180%)',
  boxShadow: 'var(--zr-edge-ring), 0 1px 2px rgba(0,0,0,0.06), 0 6px 18px rgba(0,0,0,0.07)',
  transition: hover ? 'transform .16s cubic-bezier(.25,1,.5,1), box-shadow .16s ease' : undefined,
})

// Famille de polices, exportée une seule fois (au lieu d'être redéclarée dans chaque composant).
export const FONTS = {
  serif: "'AnthropicSerif', Georgia, serif",
  sans: "'AnthropicSans', -apple-system, sans-serif",
  mono: "'AnthropicMono', ui-monospace, monospace",
}
```

