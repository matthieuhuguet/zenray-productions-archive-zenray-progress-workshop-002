```js
import { MatroskaDemuxer } from 'matroska-demuxer'

async function streamMkv(path, size, video) {
  const ms = new MediaSource()
  video.src = URL.createObjectURL(ms)
  await onceEvent(ms, 'sourceopen')

  const demux = new MatroskaDemuxer()
  // 1) lire l'en-tête (Tracks) pour connaître codecs -> construire l'init segment fMP4
  let pos = 0
  const head = await readRange(path, 0, Math.min(size - 1, 2 * 1024 * 1024 - 1))
  demux.appendChunk(head); pos += head.byteLength
  const tracks = demux.getTracks()                  // codec privé H.264 (avcC), AAC config

  const sb = ms.addSourceBuffer(codecStringFromTracks(tracks))
  sb.mode = 'segments'
  await appendAwait(sb, buildInitSegment(tracks))   // ftyp+moov à partir des codec configs

  // 2) boucle: tirer Range -> demux -> mux moof/mdat -> append, cadencé par updateend
  while (pos < size) {
    const buf = await readRange(path, pos, Math.min(size - 1, pos + 2*1024*1024 - 1))
    if (!buf.byteLength) break
    pos += buf.byteLength
    demux.appendChunk(buf)
    let block
    while ((block = demux.readBlock()) != null) {
      const seg = muxFragment(block)                // moof + mdat pour ce paquet/GOP
      await appendAwait(sb, seg)                     // backpressure naturelle
    }
  }
  ms.endOfStream()
}
```

