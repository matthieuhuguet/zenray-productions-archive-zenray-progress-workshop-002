// Probe + extraction de sous-titres, exécutés AU DROP (le File entier est dispo en RAM).
// Coût payé une fois, jamais re-payé à la lecture.
import { getFFmpeg } from './ffmpegCore.js'
import { fetchFile } from '@ffmpeg/util'

// Parse le stderr de ffmpeg (`-i` sans output sort en erreur mais imprime les streams).
function parseProbe(lines) {
  const probe = { duration: 0, container: '', video: [], audio: [], subs: [] }
  for (const l of lines) {
    const d = /Duration: (\d+):(\d+):(\d+\.\d+)/.exec(l)
    if (d) probe.duration = (+d[1]) * 3600 + (+d[2]) * 60 + parseFloat(d[3])
    const inp = /Input #0, ([^,]+),/.exec(l)
    if (inp) probe.container = inp[1].split(',')[0].trim()

    const sv = /Stream #0:(\d+)(?:\((\w+)\))?: Video: (\w+)[^,]*,.*?(\d{2,5})x(\d{2,5})/.exec(l)
    if (sv) probe.video.push({ index: +sv[1], lang: sv[2] || 'und', codec: sv[3], width: +sv[4], height: +sv[5], default: /\(default\)/.test(l) })

    const sa = /Stream #0:(\d+)(?:\((\w+)\))?: Audio: (\w+)/.exec(l)
    if (sa) probe.audio.push({ index: +sa[1], lang: sa[2] || 'und', codec: sa[3], default: /\(default\)/.test(l) })

    const ss = /Stream #0:(\d+)(?:\((\w+)\))?: Subtitle: (\w+)/.exec(l)
    if (ss) probe.subs.push({ index: +ss[1], lang: ss[2] || 'und', format: ss[3], default: /\(default\)/.test(l) })
  }
  return probe
}

export async function probeFile(file) {
  const ff = await getFFmpeg()
  const lines = []
  const onLog = ({ message }) => lines.push(message)
  ff.on('log', onLog)
  await ff.writeFile('probe.in', await fetchFile(file))
  try { await ff.exec(['-i', 'probe.in']) } catch { /* exit 1 attendu, streams déjà loggés */ }
  ff.off('log', onLog)
  await ff.deleteFile('probe.in').catch(() => {})
  return parseProbe(lines)
}

// Extrait une piste sub. ASS/SSA -> copy (.ass, pour JASSUB). subrip/mov_text/webvtt -> webvtt.
// Renvoie { ext, bytes }. PGS/dvd_subtitle (image) non supportés (à ignorer).
export async function extractSub(file, streamIndex, format) {
  const ff = await getFFmpeg()
  const isAss = /ass|ssa/.test(format)
  const out = isAss ? 'sub.ass' : 'sub.vtt'
  await ff.writeFile('sub.in', await fetchFile(file))
  await ff.exec([
    '-i', 'sub.in',
    '-map', `0:${streamIndex}`,
    ...(isAss ? ['-c:s', 'copy'] : ['-c:s', 'webvtt']),
    out,
  ])
  const bytes = await ff.readFile(out)
  await ff.deleteFile('sub.in').catch(() => {})
  await ff.deleteFile(out).catch(() => {})
  return { ext: isAss ? 'ass' : 'vtt', bytes }
}
