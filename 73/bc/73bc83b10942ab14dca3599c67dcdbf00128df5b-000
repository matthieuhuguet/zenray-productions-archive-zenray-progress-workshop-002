  "type": "chunked-media",
  "v": 1,
  "name": "Big.mp4",
  "mime": "video/mp4",
  "size": 1073741824,
  "chunkSize": 3145728,
  "count": 342,
  "dir": "media/lz9k2a-x7f3q",
  "parts": ["000", "001", "002", "...", "341"],
  "createdAt": "2026-05-30T10:00:00.000Z"
}
