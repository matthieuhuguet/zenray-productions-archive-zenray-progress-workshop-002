// SRT -> VTT : seules différences réelles = entête WEBVTT + virgule->point dans les timecodes.
// Décodage robuste (SRT souvent non-UTF8, ex Shift-JIS pour du japonais).
export function decodeSubBytes(bytes) {
  let txt = new TextDecoder('utf-8').decode(bytes)
  if (txt.includes('\uFFFD')) {
    // caractères cassés -> retomber sur windows-1252 (couvre la majorité des SRT occidentaux)
    try { txt = new TextDecoder('windows-1252').decode(bytes) } catch {}
  }
  return txt
}

export function srtToVtt(srt) {
  const body = srt
    .replace(/\r+/g, '')
    .replace(/^\uFEFF/, '')
    .replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, '$1.$2')
  return 'WEBVTT\n\n' + body
}

// objectURL VTT (same-origin blob) injectable dans <track src=...>. À révoquer après usage.
export function vttUrlFromSrt(srtText) {
  const blob = new Blob([srtToVtt(srtText)], { type: 'text/vtt' })
  return URL.createObjectURL(blob)
}
