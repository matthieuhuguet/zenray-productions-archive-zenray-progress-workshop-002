// ── Helpers boutons (miroir des classes .zr-btn*) pour usage inline ──
// variant: 'primary' | 'secondary' | 'ghost'. size: 'md' | 'sm'.
export const btn = (t, variant = 'secondary', size = 'md') => {
  const base = {
    display: 'inline-flex', alignItems: 'center', justifyContent: 'center', gap: 6,
    fontFamily: "'AnthropicSans', sans-serif", fontWeight: 600, lineHeight: 1,
    border: 'none', cursor: 'pointer', whiteSpace: 'nowrap', userSelect: 'none',
    borderRadius: size === 'sm' ? 'var(--zr-r-chip)' : 'var(--zr-r-control)',
    padding: size === 'sm' ? '5px 11px' : '8px 16px',
    fontSize: size === 'sm' ? 12 : 13,
    transition: 'transform .12s ease, box-shadow .12s ease, background .12s ease, filter .12s ease',
  }
  if (variant === 'primary') return { ...base, background: PALETTE.gradient, color: '#fff', boxShadow: 'var(--zr-edge-top), 0 2px 8px rgba(226,118,135,0.32)' }
  if (variant === 'ghost') return { ...base, background: 'transparent', color: t.textSecondary, fontWeight: 500 }
  return { ...base, background: 'var(--zr-glass-bg-strong)', color: t.textPrimary, backdropFilter: 'blur(12px) saturate(160%)', WebkitBackdropFilter: 'blur(12px) saturate(160%)', boxShadow: 'var(--zr-edge-ring), 0 1px 3px rgba(0,0,0,0.10)' }
}

// Carte de CONTENU opaque (pendant inline de .zr-card). Renommée glassCard pour
