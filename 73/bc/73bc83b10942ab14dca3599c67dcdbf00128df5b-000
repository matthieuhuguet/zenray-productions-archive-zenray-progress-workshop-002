import { FFmpeg } from '@ffmpeg/ffmpeg'
import { toBlobURL } from '@ffmpeg/util'

let ffmpegSingleton
async function getFFmpeg() {
  if (ffmpegSingleton) return ffmpegSingleton
  const ff = new FFmpeg()
  // core-st = single thread => PAS besoin de COOP/COEP ni SharedArrayBuffer
  const base = 'https://unpkg.com/@ffmpeg/core-st@0.12.6/dist/umd'
  await ff.load({
    coreURL: await toBlobURL(`${base}/ffmpeg-core.js`, 'text/javascript'),
    wasmURL: await toBlobURL(`${base}/ffmpeg-core.wasm`, 'application/wasm'),
  })
  ffmpegSingleton = ff
  return ff
}
```

### 3. Remux MKV -> fMP4 fragmenté et push dans MSE

Le point clé du streaming: ffmpeg lit depuis un fichier monté en mémoire, écrit du fMP4 fragmenté (`-movflags`). Pour vraiment streamer sans tout charger, on travaille **par segments d'octets** (ex 8 Mo), chacun remuxé indépendamment. Mais MKV n'est pas trivialement découpable par offset arbitraire (faut tomber sur une frontière de cluster). Approche pragmatique au démarrage: remuxer le fichier complet une fois écrit progressivement, OU utiliser le mode où l'on alimente ffmpeg par blocs. Le plus simple qui marche:

```js
// remux complet en un passage, mais l'entrée est tirée par Range (pas de download navigateur direct)
export async function remuxToFmp4(path, size, onInitSegment, onMediaSegment) {
  const ff = await getFFmpeg()
  const input = await readRange(path, 0, size - 1)   // pour gros fichiers: voir note seek ci-dessous
  await ff.writeFile('in.mkv', input)
  // fMP4 fragmenté = lisible par MSE ; frag_keyframe = segments alignés sur IDR
  await ff.exec([
    '-i', 'in.mkv',
    '-c', 'copy',
    '-movflags', 'frag_keyframe+empty_moov+default_base_moof',
    '-f', 'mp4', 'out.mp4',
  ])
  const data = await ff.readFile('out.mp4')          // Uint8Array fMP4
  return data
}
```

