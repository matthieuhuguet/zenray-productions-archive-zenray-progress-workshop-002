  while (pos <= end) {
    const r = await fetch(streamUrl(path), { headers: { Range: `bytes=${pos}-${end}` }, signal })
    if (r.status !== 206 && r.status !== 200) throw new Error(`range ${r.status}`)
    const buf = new Uint8Array(await r.arrayBuffer())
    if (buf.byteLength === 0) break // garde-fou anti-boucle infinie
    chunks.push(buf)
    pos += buf.byteLength
  }
  const total = chunks.reduce((n, c) => n + c.byteLength, 0)
  const out = new Uint8Array(total)
  let o = 0
  for (const c of chunks) { out.set(c, o); o += c.byteLength }
  return out
}

// Lecture des N derniers octets : l'API ne gère PAS le suffixe bytes=-N,
// donc on calcule start = size - N depuis le manifest.
export async function readTail(path, size, n, opts) {
  const start = Math.max(0, size - n)
  return readRange(path, start, size - 1, opts)
}
