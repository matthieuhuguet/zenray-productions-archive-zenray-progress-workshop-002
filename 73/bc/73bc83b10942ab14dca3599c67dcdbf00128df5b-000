// Singleton ffmpeg.wasm SINGLE-THREAD (core-st) : pas de SharedArrayBuffer,
// donc PAS de COOP/COEP requis, l'existant <video src=/api/stream> reste intact.
// Le core est SELF-HOSTÉ dans /public/ffmpeg (jamais un CDN) : sous COEP éventuel
// futur, un core CDN serait bloqué. toBlobURL le charge same-origin.
let _ff = null
let _loading = null

export async function getFFmpeg(onLog) {
  if (_ff) return _ff
  if (_loading) return _loading
  _loading = (async () => {
    const { FFmpeg } = await import('@ffmpeg/ffmpeg')
    const { toBlobURL } = await import('@ffmpeg/util')
    const ff = new FFmpeg()
    if (onLog) ff.on('log', ({ message }) => onLog(message))
    const base = '/ffmpeg' // public/ffmpeg/ffmpeg-core.js + .wasm (core-st, pas de worker)
    await ff.load({
      coreURL: await toBlobURL(`${base}/ffmpeg-core.js`, 'text/javascript'),
      wasmURL: await toBlobURL(`${base}/ffmpeg-core.wasm`, 'application/wasm'),
    })
    _ff = ff
    return ff
  })()
  try { return await _loading } finally { _loading = null }
}

// Libère la mémoire wasm. À appeler quand le lecteur se démonte.
export async function terminateFFmpeg() {
  if (_ff) { try { _ff.terminate() } catch {} _ff = null }
}
