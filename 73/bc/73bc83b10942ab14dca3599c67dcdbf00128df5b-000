### 3a. Probe (lister les pistes au drop)

ffmpeg.wasm n'expose pas ffprobe. On lance ffmpeg et on parse le stderr, ou mieux on utilise `-map` directement. Pour lister proprement, le plus fiable est de parser la sortie de ffmpeg sur un run sans output.

```js
// src/media/probe.js
import { FFmpeg } from '@ffmpeg/ffmpeg'
import { fetchFile } from '@ffmpeg/util'

let _ff
async function getFF() {
  if (_ff) return _ff
  const ff = new FFmpeg()
  // logs capturés pour le probe
  await ff.load({
    coreURL: '/ffmpeg/ffmpeg-core.js',     // self-hosté, cf section COOP/COEP
    wasmURL: '/ffmpeg/ffmpeg-core.wasm',
  })
  _ff = ff
  return ff
}

// Parse les lignes "Stream #0:2(jpn): Subtitle: ass (default)"
export async function probeSubtitles(file) {
  const ff = await getFF()
  const lines = []
  const onLog = ({ message }) => lines.push(message)
  ff.on('log', onLog)
  await ff.writeFile('in.mkv', await fetchFile(file))
  // run qui échoue volontairement vite mais imprime les streams
  try { await ff.exec(['-i', 'in.mkv']) } catch { /* exit 1 attendu, les streams sont déjà loggés */ }
  ff.off('log', onLog)
  await ff.deleteFile('in.mkv')

  const subs = []
  const re = /Stream #0:(\d+)(?:\((\w+)\))?: Subtitle: (\w+)(.*)$/
  for (const l of lines) {
    const m = l.match(re)
    if (m) subs.push({
      index: +m[1],
      lang: m[2] || 'und',
      format: m[3],                          // 'ass' | 'subrip' | 'webvtt' ...
      default: /\(default\)/.test(m[4]),
      // le titre éventuel: parse "title : ..." sur les lignes Metadata suivantes si besoin
    })
  }
  return subs
}
```

### 3b. Extraction d'une piste (à l'upload, recommandé)

```js
// extrait la piste sub d'index `streamIndex` en texte VTT (ou ASS si tu veux JASSUB)
export async function extractSub(file, streamIndex, { toVtt = true } = {}) {
  const ff = await getFF()
  await ff.writeFile('in.mkv', await fetchFile(file))
  const out = toVtt ? 'out.vtt' : 'out.ass'
  // -map 0:<index> sélectionne la piste exacte ; -c:s webvtt convertit, copy garde l'ASS
  await ff.exec([
    '-i', 'in.mkv',
    '-map', `0:${streamIndex}`,
    ...(toVtt ? ['-c:s', 'webvtt'] : ['-c:s', 'copy']),
    out,
  ])
  const data = await ff.readFile(out)            // Uint8Array
  await ff.deleteFile('in.mkv'); await ff.deleteFile(out)
  return new TextDecoder('utf-8').decode(data)
}
```

Piège majeur : `-c:s webvtt` **détruit le style ASS** (positions, couleurs, karaoké tombent). Donc la règle de routage à l'extraction :
