    if (!p.startsWith(prefix)) continue
    const rest = stripExt(p.slice(prefix.length))
    if (!rest) continue
    const seg = rest.split('/')[0]
    const isLeaf = rest.indexOf('/') === -1
    map[seg] = map[seg] || { name: seg, contentPath: null, hasKids: false, dir: prefix + seg }
    if (isLeaf) { map[seg].contentPath = p; map[seg].kind = space.kindOf(p) }
    else map[seg].hasKids = true
  }
  return Object.values(map).sort((a, b) => a.name.localeCompare(b.name))
}
```

L'entrée gagne un champ **`kind`** ('page'|'db'|'media'|'image'|'record') qui remplace les booléens `isDb`/`isMedia` épars. Le renderer et les icônes se branchent dessus. **`buildTree`** subit la même paramétrisation (préfixe = `space.root`, extensions = `space.exts`).

