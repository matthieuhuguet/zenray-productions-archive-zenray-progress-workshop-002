```js
// Niveau 2 (remux -c copy) et niveau 3 (transcode) : alimentent un MediaSource.
// Source d'octets = readRange (/api/stream). ffmpeg.wasm core-st.
import { getFFmpeg } from './ffmpegCore.js'
import { readRange } from './rangeReader.js'

const MIME_VCODEC = { h264: 'avc1.640029', avc: 'avc1.640029', hevc: 'hvc1.1.6.L93.B0', h265: 'hvc1.1.6.L93.B0' }

function appendBuf(sb, data) {
  return new Promise((res, rej) => {
    const ok = () => { sb.removeEventListener('error', ko); res() }
    const ko = (e) => { sb.removeEventListener('updateend', ok); rej(e) }
    sb.addEventListener('updateend', ok, { once: true })
    sb.addEventListener('error', ko, { once: true })
    sb.appendBuffer(data)
  })
}
function onceEvent(target, ev) {
  return new Promise((res) => target.addEventListener(ev, res, { once: true }))
}

// Décide remux vs transcode depuis le probe (si dispo). Sans probe -> tente remux.
export function pickPipeline(probe) {
  if (!probe || !probe.video || !probe.video.length) return 'remux'
  const v = probe.video[0]
  const vMime = MIME_VCODEC[v.codec]
  if (!vMime) return 'transcode'
  const ok = ('MediaSource' in window) && MediaSource.isTypeSupported(`video/mp4; codecs="${vMime}"`)
  return ok ? 'remux' : 'transcode'
}

// codec string MSE pour le SourceBuffer unifié (remux). audioTrack = index dans probe.audio.
function codecString(probe, audioTrack) {
  const v = probe?.video?.[0]
  const vMime = (v && MIME_VCODEC[v.codec]) || 'avc1.640029'
  return `video/mp4; codecs="${vMime},mp4a.40.2"`
}

// ── NIVEAU 2 : remux -c copy (audio copy si AAC, sinon aac) ──────────────
// audioTrack = index de la piste audio voulue (dans probe.audio), null = défaut/première.
export async function playRemux({ path, manifest, video, audioTrack = null, onState, signal }) {
  const ff = await getFFmpeg()
  const probe = manifest.probe
  onState?.('Lecture du fichier…')
  const input = await readRange(path, 0, manifest.size - 1, { signal })
  if (signal?.aborted) throw new DOMException('aborted', 'AbortError')

  await ff.writeFile('in', input)
  onState?.('Remux en cours…')

  const aChosen = audioTrack != null ? probe?.audio?.[audioTrack] : (probe?.audio?.find(a => a.default) || probe?.audio?.[0])
  const aCodec = aChosen?.codec
  const aMap = aChosen ? ['-map', `0:${aChosen.index}`] : []
  const aArgs = aCodec === 'aac' ? ['-c:a', 'copy'] : ['-c:a', 'aac', '-b:a', '192k']

  const args = [
    '-i', 'in',
    '-map', '0:v:0', ...aMap,
    '-c:v', 'copy', ...aArgs,
    '-movflags', 'frag_keyframe+empty_moov+default_base_moof',
    '-f', 'mp4', 'out.mp4',
  ]
  try {
    await ff.exec(args)
  } catch (e) {
    await ff.deleteFile('in').catch(() => {})
    throw new Error('remux-failed')
  }
  const data = await ff.readFile('out.mp4')
  await ff.deleteFile('in').catch(() => {})
  await ff.deleteFile('out.mp4').catch(() => {})

  const ms = new MediaSource()
  const objUrl = URL.createObjectURL(ms)
  video.src = objUrl
  await onceEvent(ms, 'sourceopen')

  const cs = codecString(probe, audioTrack)
  if (!MediaSource.isTypeSupported(cs)) { URL.revokeObjectURL(objUrl); throw new Error('codec-unsupported') }
  const sb = ms.addSourceBuffer(cs)
  sb.mode = 'segments'
  await appendBuf(sb, data)
  if (ms.readyState === 'open') ms.endOfStream()
  onState?.(null)
  return { mediaSource: ms, objUrl }
}

// ── NIVEAU 3 : transcode segmenté libx264 + aac ─────────────────────────
export async function playTranscode({ path, manifest, video, onPct, onState, signal }) {
  const ff = await getFFmpeg()
  const duration = manifest.probe?.duration || 0
  onState?.('Lecture du fichier…')
  const input = await readRange(path, 0, manifest.size - 1, { signal })
  if (signal?.aborted) throw new DOMException('aborted', 'AbortError')
  await ff.writeFile('in', input)

  const ms = new MediaSource()
  const objUrl = URL.createObjectURL(ms)
  video.src = objUrl
  await onceEvent(ms, 'sourceopen')
  const sb = ms.addSourceBuffer('video/mp4; codecs="avc1.640029,mp4a.40.2"')
  sb.mode = 'sequence'

  const SEG = 8
  onState?.('Transcodage…')
  try {
    for (let t = 0, i = 0; t < (duration || Infinity); t += SEG, i++) {
      if (signal?.aborted) throw new DOMException('aborted', 'AbortError')
      const out = `s${i}.mp4`
      await ff.exec([
        '-ss', String(t), '-t', String(SEG), '-i', 'in',
        '-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '23',
        '-c:a', 'aac', '-b:a', '160k',
        '-movflags', 'frag_keyframe+empty_moov+default_base_moof',
        '-f', 'mp4', out,
      ])
      const data = await ff.readFile(out)
      await ff.deleteFile(out).catch(() => {})
      if (data.byteLength === 0) break // fin atteinte
      await appendBuf(sb, data)
      if (duration) onPct?.(Math.min(1, (t + SEG) / duration))
    }
  } finally {
    await ff.deleteFile('in').catch(() => {})
  }
  if (ms.readyState === 'open') ms.endOfStream()
  onState?.(null)
  return { mediaSource: ms, objUrl }
}
