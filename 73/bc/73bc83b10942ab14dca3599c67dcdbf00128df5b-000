## Flux technique concret — Option B (ffmpeg.wasm `-c copy`, single-thread)

### 1. Source d'octets: ton `rangeReader` sur `/api/stream`

```js
// src/media/rangeReader.js
const enc = encodeURIComponent
const streamUrl = (path) => `/api/stream?path=${enc(path)}`

// L'API borne chaque réponse à 2 Mo -> on BOUCLE jusqu'à couvrir [start,end].
export async function readRange(path, start, end) {
  const chunks = []
  let pos = start
  while (pos <= end) {
    const r = await fetch(streamUrl(path), { headers: { Range: `bytes=${pos}-${end}` } })
    if (!r.ok && r.status !== 206 && r.status !== 200) throw new Error(`range ${r.status}`)
    const buf = new Uint8Array(await r.arrayBuffer())
    if (buf.byteLength === 0) break          // garde-fou anti-boucle infinie
    chunks.push(buf)
    pos += buf.byteLength                     // avancer du RÉEL reçu, pas du demandé
  }
  // concat
  const total = chunks.reduce((n, c) => n + c.byteLength, 0)
  const out = new Uint8Array(total)
  let o = 0
  for (const c of chunks) { out.set(c, o); o += c.byteLength }
  return out
}
```

### 2. Chargement paresseux de ffmpeg.wasm (single-thread, pas de SAB)

```js
