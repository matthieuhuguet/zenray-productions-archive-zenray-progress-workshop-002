import React, { useEffect, useRef, useState } from 'react'
import { PALETTE, RADII, SHADOWS, TRANSITIONS } from '../theme.js'
import { loadChunked, readManifest } from '../media/chunked.js'

// Barre identique au backbone (cf App.jsx <Bar/>), isolée ici pour le viewer.
function ProgressBar({ t, value }) {
  return (
    <div style={{ width: '100%', height: 8, borderRadius: 99, background: t.border, overflow: 'hidden' }}>
      <div style={{ width: `${Math.round((value || 0) * 100)}%`, height: '100%', background: PALETTE.gradient, transition: TRANSITIONS && TRANSITIONS.smooth ? TRANSITIONS.smooth : 'width .25s ease' }} />
    </div>
  )
}

// Lecteur de média chunké : lit le manifest, réassemble côté client en Blob, lit/télécharge.
export default function MediaViewer({ t, path, title }) {
  const [m, setM] = useState(null)
  const [progress, setProgress] = useState(0)
  const [phase, setPhase] = useState('idle') // idle | meta | loading | ready | error
  const [err, setErr] = useState(null)
  const urlRef = useRef(null)
  const [url, setUrl] = useState(null)

  // métadonnées d'abord (affichage instantané : nom, taille, nb parts)
  useEffect(() => {
    let live = true
    setPhase('meta'); setM(null); setUrl(null); setProgress(0); setErr(null)
    readManifest(path).then((mm) => { if (live) { setM(mm); setPhase('idle') } }).catch((e) => { if (live) { setErr(String(e.message || e)); setPhase('error') } })
    return () => { live = false }
  }, [path])

  // libère l'objectURL au démontage / changement (zéro fuite mémoire)
  useEffect(() => () => { if (urlRef.current) URL.revokeObjectURL(urlRef.current) }, [])

  const start = async () => {
    setPhase('loading'); setProgress(0); setErr(null)
    try {
      const { url: u } = await loadChunked(path, (r) => setProgress(r))
      if (urlRef.current) URL.revokeObjectURL(urlRef.current)
      urlRef.current = u
      setUrl(u); setPhase('ready')
    } catch (e) { setErr(String(e.message || e)); setPhase('error') }
  }

  const isVideo = m && m.mime && m.mime.startsWith('video/')
  const isAudio = m && m.mime && m.mime.startsWith('audio/')
  const card = { background: t.surface, border: `1px solid ${t.border}`, borderRadius: RADII.lg, boxShadow: SHADOWS.md, padding: 22, maxWidth: 760, margin: '0 auto' }
  const button = { padding: '8px 18px', borderRadius: RADII.md, border: `1px solid ${PALETTE.primary}`, background: PALETTE.primarySoft || 'transparent', color: PALETTE.primary, cursor: 'pointer', fontSize: 13, fontWeight: 600 }

  return (
    <div style={{ padding: 24 }}>
      <div style={card}>
        <div style={{ fontFamily: "'AnthropicSans', sans-serif", fontSize: 24, fontWeight: 700, marginBottom: 6, color: t.textPrimary }}>{title || (m && m.name)}</div>
        {m && <div style={{ color: t.textSecondary, fontSize: 12.5, marginBottom: 16 }}>{(m.size / 1048576).toFixed(1)} Mo · {m.count} parties · {m.mime}</div>}

        {phase === 'error' && <div style={{ color: PALETTE.red || '#ff5f57', fontSize: 13 }}>Erreur : {err}</div>}

        {phase !== 'ready' && phase !== 'error' && (
          <div>
            {phase === 'loading' && (
              <div style={{ marginBottom: 14 }}>
                <ProgressBar t={t} value={progress} />
                <div style={{ marginTop: 6, fontSize: 12, color: t.textSecondary, fontFamily: 'monospace' }}>{Math.round(progress * 100)} %</div>
              </div>
            )}
            <button style={button} disabled={phase === 'loading' || phase === 'meta'} onClick={start}>
              {phase === 'loading' ? 'Chargement…' : 'Charger le média'}
            </button>
          </div>
        )}

        {phase === 'ready' && url && (
          <div>
            {isVideo && <video src={url} controls style={{ width: '100%', borderRadius: RADII.md, background: '#000' }} />}
            {isAudio && <audio src={url} controls style={{ width: '100%' }} />}
            {!isVideo && !isAudio && (
              <a href={url} download={m && m.name} style={{ ...button, display: 'inline-block', textDecoration: 'none' }}>Télécharger {m && m.name}</a>
            )}
            {(isVideo || isAudio) && (
              <a href={url} download={m && m.name} style={{ display: 'inline-block', marginTop: 12, fontSize: 12.5, color: PALETTE.primary, textDecoration: 'none' }}>Télécharger le fichier</a>
            )}
          </div>
        )}
      </div>
    </div>
  )
}
```

