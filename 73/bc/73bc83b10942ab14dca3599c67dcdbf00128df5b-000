// src/components/subtitles/SubtitleLayer.jsx
import { useEffect, useRef } from 'react'

// charge le texte d'une piste sub depuis le drive (path du manifest) ou un objectURL externe
async function loadSubText(src) {
  const r = await fetch(src)
  return await r.text()
}

export default function SubtitleLayer({ videoRef, track }) {
  // track = { format, src }  (src = url VTT blob OU url ASS du drive)
  const jassubRef = useRef(null)
  const trackElRef = useRef(null)

  useEffect(() => {
    const video = videoRef.current
    if (!video || !track) return cleanup

    let cancelled = false
    ;(async () => {
      if (track.format === 'ass' || track.format === 'ssa') {
        // ASS -> JASSUB (libass.wasm), chargé paresseusement
        const { default: JASSUB } = await import('jassub')
        const subContent = await loadSubText(track.src)
        if (cancelled) return
        jassubRef.current = new JASSUB({
          video,
          subContent,                                   // le texte .ass
          workerUrl: '/jassub/jassub-worker.js',        // self-hosté
          wasmUrl: '/jassub/jassub-worker.wasm',
          // fallbackFont + availableFonts si polices embarquées extraites
        })
      } else {
        // VTT/SRT -> <track> natif
        const el = document.createElement('track')
        el.kind = 'subtitles'
        el.src = track.src                              // objectURL VTT
        el.default = true
        video.appendChild(el)
        el.track.mode = 'showing'
        trackElRef.current = el
      }
    })()

    return cleanup
    function cleanup() {
      cancelled = true
      if (jassubRef.current) { jassubRef.current.destroy(); jassubRef.current = null }
      if (trackElRef.current) { trackElRef.current.remove(); trackElRef.current = null }
    }
  }, [track, videoRef])

  return null  // JASSUB gère son propre canvas, <track> est natif
}
```

