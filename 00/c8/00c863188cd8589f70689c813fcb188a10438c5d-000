.zrm-palette-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.48);z-index:100;display:none;align-items:flex-start;justify-content:center;padding-top:90px}.zrm-palette-backdrop.open{display:flex}.zrm-palette{width:min(680px,calc(100vw - 28px));border-radius:22px;overflow:hidden}.zrm-palette input{width:100%;height:54px;border:0;border-bottom:1px solid var(--line);background:transparent;padding:0 18px;outline:0;font-size:14px}.zrm-palette-list{padding:8px;display:grid;gap:3px}.zrm-palette-item{height:42px;border:0;background:transparent;border-radius:10px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;color:var(--muted);text-align:left}.zrm-palette-item:hover{background:var(--glass-a);color:var(--text)}.zrm-palette-item small{font-size:9px}.zrm-toast{position:fixed;right:18px;bottom:18px;z-index:120;min-width:260px;max-width:360px;padding:13px 15px;border-radius:14px;transform:translateY(30px);opacity:0;pointer-events:none;transition:.3s var(--ease);font-size:11px}.zrm-toast.show{transform:none;opacity:1}.zrm-mobile-nav{display:none}
