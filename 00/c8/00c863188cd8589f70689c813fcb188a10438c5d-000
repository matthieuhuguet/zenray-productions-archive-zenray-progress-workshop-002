const hi=document.getElementById('headlineInput');hi.oninput=()=>document.getElementById('articleHeadline').textContent=hi.value;
document.querySelectorAll('[data-editor-mode]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-editor-mode]').forEach(x=>x.classList.remove('active'));b.classList.add('active');const mode=b.dataset.editorMode;const canvas=document.getElementById('mediaCanvas');if(mode==='article'){canvas.style.aspectRatio='auto';canvas.style.maxWidth='940px';canvas.style.minHeight='570px'}if(mode==='video'){canvas.style.maxWidth='940px';canvas.style.minHeight='0';canvas.style.aspectRatio='16/9'}if(mode==='social'){canvas.style.maxWidth='360px';canvas.style.minHeight='640px';canvas.style.aspectRatio='9/16'}showToast(`${mode} composition selected`)});
function renderTemplates(){const q=(document.getElementById('templateSearch').value||'').toLowerCase();const family=document.getElementById('familyFilter').value;const data=FEATURED.filter(x=>(!q||`${x.name} ${x.family} ${x.benchmark} ${x.type}`.toLowerCase().includes(q))&&(!family||x.family.includes(family)));document.getElementById('templateGrid').innerHTML=data.map((x,i)=>`<article class="zrm-card zrm-template" style="--accent:${x.accent}"><div class="zrm-template-preview"></div><h3>${x.name}</h3><p>${x.benchmark}<br>${x.type}</p><div class="zrm-template-meta"><span>${x.status}</span><button class="zrm-mini-btn" data-toast="Template loaded in Create">Use</button></div></article>`).join('')||'<p style="color:var(--muted)">No template matches.</p>'}
document.getElementById('templateSearch').oninput=renderTemplates;document.getElementById('familyFilter').onchange=renderTemplates;renderTemplates();
document.getElementById('referenceMap').innerHTML=BENCHMARKS.map((x,i)=>`<article class="zrm-card zrm-reference-card"><strong>${x.name}</strong><small>${x.category}</small><p>${x.role}</p></article>`).join('');
const assetNames=['Hero valley','Onsen exterior','Portrait host','Train arrival','Access map','Autumn crop','Snow crop','YouTube thumbnail','Reel cover','Ambient forest','Title overlay','Japanese glyph set'];document.getElementById('assetsGrid').innerHTML=Array.from({length:12},(_,i)=>`<article class="zrm-card zrm-asset"><div class="zrm-asset-thumb" style="--a:hsl(${330-i*17} 48% 52%);--b:hsl(${150+i*11} 34% 29%)"></div><h3>${assetNames[i]}</h3><div class="zrm-asset-meta"><span>${i<8?'image':'motion'} · ${(i+2)*1.4|0} MB</span><span class="zrm-license">${i<9?'owned':'verify'}</span></div></article>`).join('');
const jobs=[['Article web','1440 responsive','100%','#d84275'],['YouTube chapter','1920×1080 · H.264','62%','#3b82f7'],['Vertical teaser','1080×1920 · H.264','31%','#9d72ff'],['Instagram carousel','1080×1350 · 8 frames','Queued','#ff8b45'],['Motion overlay alpha','3840×2160 · ProRes 4444','Queued','#35c89b']];document.getElementById('renderJobs').innerHTML=jobs.map((j,i)=>`<div class="zrm-job"><div class="zrm-job-preview" style="--accent:${j[3]}"></div><div><h3>${j[0]}</h3><p>${j[1]}</p></div><div><div class="zrm-progress"><i style="--p:${j[2].includes('%')?j[2]:'0%'}"></i></div><p>${j[2]}</p></div><div class="zrm-job-actions"><button class="zrm-mini-btn" data-toast="Job inspected">Open</button></div></div>`).join('');
document.getElementById('runQueue').onclick=()=>{showToast('Render queue started');document.getElementById('renderLog').textContent+='\n[running] youtube frames 1180 / 1800\n[running] vertical frames 421 / 1350'};
const platforms=[['YouTube','direct','16:9 chapter','ready'],['Instagram','direct','9:16 Reel','ready'],['TikTok','draft-handoff','9:16 teaser','warning'],['LinkedIn','direct','Article + image','ready'],['WordPress','direct','HTML article','ready'],['ArtStation','manual-export','Case study package','handoff']];document.getElementById('platformRows').innerHTML=platforms.map((p,i)=>`<tr><td><input type="checkbox" ${i<5?'checked':''}></td><td><div class="zrm-platform"><span class="zrm-platform-icon">${p[0].slice(0,2)}</span>${p[0]}</div></td><td><span class="zrm-support ${p[1]!=='direct'?'handoff':''}">${p[1]}</span></td><td>${p[2]}</td><td>${p[3]}</td></tr>`).join('');
document.getElementById('publishRun').onclick=()=>{showToast('Validation complete · 4 direct, 2 handoff');document.querySelectorAll('#platformRows tr').forEach((r,i)=>r.lastElementChild.textContent=i<4?'scheduled':i===4?'published':'handoff')};
const connectors=[['YouTube','direct','Connected','videos.insert · resumable'],['Instagram','direct','Connected','Professional account'],['TikTok','draft-handoff','Audit required','Private/direct constraints'],['LinkedIn','direct','Connected','Member + organization'],['WordPress','direct','Connected','REST adapter'],['ArtStation','manual-export','Handoff','No verified public write API']];document.getElementById('connectorGrid').innerHTML=connectors.map(x=>`<article class="zrm-card zrm-system-card"><span class="icon">${x[0].slice(0,2)}</span><h3>${x[0]}</h3><p>${x[3]}</p><footer><span>${x[1]}</span><span class="zrm-status ${x[1]!=='direct'?'wait':''}">${x[2]}</span></footer></article>`).join('');
const initial=location.hash.slice(1);if(navItems.some(x=>x[0]===initial))go(initial);
</script>
</body></html>