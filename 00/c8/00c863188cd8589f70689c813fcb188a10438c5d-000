0 24 24" fill="none" stroke="currentColor"><path d="M4 6h16v12H4z"/><path d="M8 10h8M8 14h5"/></svg><strong>Campaign</strong><small>Multi-format system</small></button><button class="zrm-output"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 4h16v16H4z"/><circle cx="9" cy="9" r="2"/><path d="m6 17 4-4 3 3 2-2 3 3"/></svg><strong>Visual</strong><small>Poster, key art, print</small></button><button class="zrm-output"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 8h16M4 16h16M8 4v16M16 4v16"/></svg><strong>Custom</strong><small>Skill or CLI recipe</small></button></div></div><aside class="zrm-card zrm-card-body"><div class="zrm-form-list"><div class="zrm-field"><label>Project</label><input class="zrm-input" value="Japan Hidden Spring"></div><div class="zrm-field"><label>Reference intelligence</label><select class="zrm-select"><option>Ichiban Japan × Monocle</option><option>National Geographic × Kinfolk</option><option>Custom benchmark set</option></select></div><div class="zrm-field"><label>Audience</label><input class="zrm-input" value="French travelers · Japan"></div><div class="zrm-field"><label>Approval policy</label><select class="zrm-select"><option>Manual before render</option><option>Manual before publish</option><option>Two-step approval</option></select></div><div class="zrm-field"><label>Storage</label><select class="zrm-select"><option>Local project + object store</option><option>Local only</option></select></div></div><div class="zrm-form-footer"><span>Estimated first graph · 20–40 s</span><span>Reversible</span></div></aside></div></section>
<!-- EDITOR -->
