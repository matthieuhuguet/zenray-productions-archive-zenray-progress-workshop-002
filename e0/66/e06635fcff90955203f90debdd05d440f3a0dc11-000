.zrm-lm-rail{display:grid;gap:22px}.zrm-lm-rail-box{background:#fff;border:1px solid var(--zrm-lm-line);padding:18px}.zrm-lm-rail-box--top{border-top:4px solid var(--zrm-lm-line-dark)}
