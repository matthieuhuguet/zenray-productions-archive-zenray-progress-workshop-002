.zrm-lm-game{border:1px solid #cfd4dc;padding:23px;text-align:center;background:#fff}.zrm-lm-game__logo{font-family:var(--zrm-lm-serif);font-weight:800;font-size:20px}.zrm-lm-game__grid{display:grid;grid-template-columns:repeat(3,31px);gap:5px;justify-content:center;margin:18px 0}.zrm-lm-game__grid span{height:31px;display:grid;place-items:center;background:#5eaaa4;color:#fff;font-weight:800}.zrm-lm-game__title{font:900 18px/1 var(--zrm-lm-sans)}.zrm-lm-game__copy{color:#747e8e;font-size:14px;margin:7px 0 13px}

