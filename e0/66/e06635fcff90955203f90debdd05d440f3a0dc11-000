.zrm-lm-icon-search{width:16px;height:16px;border:2px solid currentColor;border-radius:50%;position:relative;margin-right:5px}.zrm-lm-icon-search:after{content:'';position:absolute;width:7px;border-top:2px solid currentColor;transform:rotate(45deg);right:-5px;bottom:-2px}
