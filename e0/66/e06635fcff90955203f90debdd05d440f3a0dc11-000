.zrm-lm-home-hero__update{font:700 16px/1.35 var(--zrm-lm-serif);margin:0 0 18px}.zrm-lm-home-hero__time{color:#d8322d;font-family:var(--zrm-lm-body);font-weight:800}
.zrm-lm-figure{margin:0}.zrm-lm-figure img{width:100%;height:auto}.zrm-lm-figure__caption{display:flex;justify-content:space-between;gap:18px;color:#5f6672;font-size:12px;padding-top:7px}
.zrm-lm-carousel{position:relative}.zrm-lm-carousel__controls{position:absolute;left:14px;right:14px;bottom:14px;display:flex;align-items:center;justify-content:space-between;color:#fff}.zrm-lm-carousel__left{display:flex;gap:8px}.zrm-lm-round{width:35px;height:35px;border:0;border-radius:50%;background:rgba(31,34,40,.72);color:#fff;font-size:24px}.zrm-lm-dots{display:flex;gap:7px;background:rgba(31,34,40,.68);padding:10px 14px;border-radius:999px}.zrm-lm-dots i{display:block;width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.45)}.zrm-lm-dots i.is-active{background:#fff}
