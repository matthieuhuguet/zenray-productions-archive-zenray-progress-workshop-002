.zrm-lm-section-layout{display:grid;grid-template-columns:minmax(0,700px) 375px;gap:70px;padding:42px 0 80px;border-top:3px solid #344052}.zrm-lm-section-card{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:20px;padding:28px 0;border-bottom:1px solid var(--zrm-lm-line)}.zrm-lm-section-card__title{font:800 22px/1.14 var(--zrm-lm-serif);margin:0 0 12px}.zrm-lm-section-card__dek{font-size:15px;line-height:1.5;color:#555f6e}.zrm-lm-section-card__meta{font-size:12px;color:#7c8696;margin-top:12px}.zrm-lm-section-card img{width:190px;height:126px;object-fit:cover}

