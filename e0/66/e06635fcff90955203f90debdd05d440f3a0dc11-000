.zrm-lm-live-card__head{display:flex;justify-content:space-between;align-items:center;font:900 14px/1 var(--zrm-lm-sans);margin-bottom:28px}.zrm-lm-live-card__title{font:800 18px/1.25 var(--zrm-lm-body);margin:0 0 20px}.zrm-lm-live-card__body{font-size:17px;line-height:1.55;color:#4b5463}.zrm-lm-live-card__body p{margin:0 0 22px}
.zrm-lm-live-rail{display:grid;gap:24px}.zrm-lm-facts{display:grid;grid-template-columns:7px 1fr auto;background:#fff;box-shadow:0 4px 18px rgba(26,35,48,.04)}.zrm-lm-facts__bar{background:#d82d2d}.zrm-lm-facts__title{padding:25px 20px;color:#d82d2d;font:900 15px/1 var(--zrm-lm-sans)}.zrm-lm-facts__action{padding:25px 20px;color:#3778da}
