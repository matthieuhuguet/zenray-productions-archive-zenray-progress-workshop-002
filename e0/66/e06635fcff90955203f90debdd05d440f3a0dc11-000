.zrm-lm-kiosk{background:#fff}.zrm-lm-kiosk-head{height:64px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 20px;border-bottom:1px solid var(--zrm-lm-line)}.zrm-lm-kiosk-head__title{font:900 18px/1 var(--zrm-lm-sans);text-transform:uppercase}.zrm-lm-kiosk-head__actions{justify-self:end;display:flex;gap:14px;align-items:center}.zrm-lm-login{height:38px;padding:0 15px;border:0;border-radius:4px;background:#2b3441;color:#fff;font-weight:700}
