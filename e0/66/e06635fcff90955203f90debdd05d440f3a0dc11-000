.zrm-lm-header--compact .zrm-lm-header__top{min-height:74px;grid-template-columns:auto 1fr auto;padding:10px 30px}
.zrm-lm-header--compact .zrm-lm-header__tools{gap:18px}.zrm-lm-header--compact .zrm-lm-tool{flex-direction:row;min-width:auto;font-size:14px}
