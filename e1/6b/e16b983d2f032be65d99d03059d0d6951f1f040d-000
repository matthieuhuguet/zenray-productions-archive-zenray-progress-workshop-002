/* T-01-1-2 — tokens relevés sur les captures LIBE (3655x2152 et 3669x2160).
   FONTE DE TITRAGE : Anton, identifiée par Matthieu au What-The-Google-Font.
   Anton n'a QU'UNE graisse (400) qui rend déjà noir : tout `font-weight:700` sur elle
   déclencherait un faux gras synthétique qui empâte les contreformes carrées — exactement
   ce qui faisait rater le rendu avec Archivo Narrow. On ne la met JAMAIS en gras. */
:root{
  --zrm-ink:      #14100e;
  --zrm-paper:    #ffffff;
  --zrm-wash:     #f5f4f2;
  --zrm-band:     #efeeec;
  --zrm-chip:     #f2f1ef;
  --zrm-red:      #e5241d;
  --zrm-red-deep: #c8201a;
  --zrm-rule:     #d8d6d4;
  --zrm-meta:     #6e6e6e;
  --zrm-sub:      #e9a13b;
  --zrm-blue:     #1e73d2;
  --zrm-night:    #111111;
  --zrm-yellow:   #f2e94b;
  --zrm-olive:    #b8a63c;

  --u: clamp(13px, 1.85vw, 30px);
  --measure: 66ch;

  --f-display: 'Anton', 'Arial Narrow', Impact, sans-serif;
  --f-body:    'Spectral', Georgia, 'Times New Roman', serif;
  --f-meta:    'Public Sans', system-ui, -apple-system, sans-serif;
}
*{ box-sizing:border-box; }
html,body{ margin:0; padding:0; }
body{
  background:var(--zrm-wash); color:var(--zrm-ink);
  font-family:var(--f-body); font-size:var(--u); line-height:1.52;
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
}
/* Règle unique et centrale : tout ce qui est en Anton reste en 400.
   Anton porte sa noirceur dans son dessin, pas dans une graisse. */
.zrm-title,.zrm-headline,.zrm-kicker,.zrm-rubric,.zrm-beat-label,.zrm-logo span,
.zrm-subscribe b,.zrm-promo-mark,.zrm-news b,.zrm-pull q,.zrm-also b{ font-weight:400; }
body{margin:0;background:var(--zrm-scene, var(--zrm-wash, #f5f4f2));color:var(--zrm-ink,inherit);}
/* Le surtitre rouge est LA constante du systeme : il precede chaque titre, partout. */
.zrm-kicker{ margin:0 0 .18em; color:var(--zrm-red); font-family:var(--f-display);
  font-weight:400; font-size:1.02em; line-height:1.1; }
.zrm-kicker[data-tone="deep"]{ color:var(--zrm-red-deep); }
