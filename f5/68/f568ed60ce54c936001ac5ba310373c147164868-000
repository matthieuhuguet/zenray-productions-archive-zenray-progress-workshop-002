<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Le Monde Component Lab — Offline</title><style>:root{
  --zrm-lm-bg:#f3f4f6;
  --zrm-lm-paper:#fff;
  --zrm-lm-ink:#202735;
  --zrm-lm-ink-soft:#4c5565;
  --zrm-lm-muted:#7d8798;
  --zrm-lm-line:#dfe3e8;
  --zrm-lm-line-dark:#2b3444;
  --zrm-lm-night:#15191e;
  --zrm-lm-night-2:#1b2027;
  --zrm-lm-yellow:#ffc900;
  --zrm-lm-red:#d42f2f;
  --zrm-lm-blue:#4e7da9;
  --zrm-lm-purple:#403c96;
