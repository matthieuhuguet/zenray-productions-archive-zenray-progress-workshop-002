.zrm-lm-link-grid__item{padding:17px 0;border-bottom:1px solid var(--zrm-lm-line);font:800 18px/1.2 var(--zrm-lm-serif)}

/* CARDS */
.zrm-lm-home-grid{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:38px;margin-top:40px}
.zrm-lm-card-stack{display:grid;gap:28px}
.zrm-lm-card-h{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:20px;padding-bottom:28px;border-bottom:1px solid var(--zrm-lm-line)}
.zrm-lm-card-h__title{font:800 24px/1.08 var(--zrm-lm-serif);letter-spacing:-.015em;margin:0 0 13px}.zrm-lm-card-h__dek{font-size:16px;line-height:1.5;color:#626b7b}.zrm-lm-card-h__image{width:100%;height:238px;object-fit:cover}.zrm-lm-card-h__credit{text-align:right;font-size:9px;text-transform:uppercase;color:#7d8593;margin-top:5px}
.zrm-lm-rail{display:grid;gap:22px}.zrm-lm-rail-box{background:#fff;border:1px solid var(--zrm-lm-line);padding:18px}.zrm-lm-rail-box--top{border-top:4px solid var(--zrm-lm-line-dark)}
.zrm-lm-rail-title{font:900 28px/1.05 var(--zrm-lm-sans);margin:0 0 17px;color:#293140}.zrm-lm-rail-article__title{font:800 19px/1.13 var(--zrm-lm-serif);margin:0 0 12px}.zrm-lm-rail-article img{width:100%;height:238px;object-fit:cover}.zrm-lm-rail-meta{font-size:12px;font-weight:700;margin:0 0 13px}.zrm-lm-service{background:#f0f6fa;border:0}.zrm-lm-service__brand{font-size:12px;color:#1371a2;font-weight:700;margin-bottom:15px}.zrm-lm-service__title{font:900 17px/1.1 var(--zrm-lm-sans);text-transform:uppercase;margin:0 0 6px}.zrm-lm-service__body{font:16px/1.3 var(--zrm-lm-serif)}.zrm-lm-service__link{display:inline-block;margin-top:12px;text-decoration:underline;font-weight:700}
.zrm-lm-most-read{counter-reset:lmread;display:grid}.zrm-lm-most-read__item{counter-increment:lmread;display:grid;grid-template-columns:25px 1fr;gap:12px;padding:17px 0;border-top:1px solid var(--zrm-lm-line);font:18px/1.3 var(--zrm-lm-serif)}.zrm-lm-most-read__item:before{content:counter(lmread);font:400 26px/1 var(--zrm-lm-serif)}
.zrm-lm-mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 30px;margin-top:40px;border-bottom:3px solid #384152;padding-bottom:26px}.zrm-lm-mini-card{display:grid;grid-template-columns:minmax(0,1fr) 132px;gap:16px;padding:0 0 28px;margin-bottom:26px;border-bottom:1px solid var(--zrm-lm-line)}.zrm-lm-mini-card__title{font:800 18px/1.18 var(--zrm-lm-serif);margin:0}.zrm-lm-mini-card img{width:132px;height:88px;object-fit:cover}

/* ARTICLE */
.zrm-lm-article{background:var(--zrm-lm-bg)}
.zrm-lm-article-hero{background:#fff;padding:36px 0 26px}.zrm-lm-article-hero__kicker{font:700 14px/1 var(--zrm-lm-sans);text-transform:uppercase;letter-spacing:.08em;color:#718096;margin-bottom:18px}.zrm-lm-article-hero__title{font:800 clamp(42px,4.25vw,66px)/1.02 var(--zrm-lm-serif);letter-spacing:-.03em;margin:0 0 18px;max-width:1020px}.zrm-lm-article-hero__dek{font:700 19px/1.35 var(--zrm-lm-body);max-width:1050px;margin:0 0 20px}.zrm-lm-article-meta{display:flex;flex-wrap:wrap;gap:8px 13px;color:#718096;font-size:14px}.zrm-lm-action-row{display:flex;gap:14px;margin-top:20px}.zrm-lm-read-later{height:38px;padding:0 15px;border-radius:999px;border:1px solid #aeb6c2;background:#fff;color:#3c4655}.zrm-lm-share{width:38px;height:38px;border:0;background:#fff;font-size:22px}
