.zrm-lm-header__account{justify-content:flex-end}
.zrm-lm-tool{display:flex;flex-direction:column;align-items:center;gap:5px;font-size:12px;color:#f1f1f2;min-width:50px}
.zrm-lm-tool__icon{width:21px;height:18px;position:relative;opacity:.95}
.zrm-lm-tool__icon--paper{border:2px solid currentColor;border-radius:2px}
.zrm-lm-tool__icon--paper:before{content:'';position:absolute;left:4px;right:4px;top:4px;height:2px;background:currentColor;box-shadow:0 4px 0 currentColor,0 8px 0 currentColor}
.zrm-lm-tool__icon--grid{background:radial-gradient(circle,currentColor 2px,transparent 2.5px) 0 0/7px 7px}
.zrm-lm-logo{height:58px;width:auto;object-fit:contain}
.zrm-lm-logo--compact{height:40px;width:auto}
.zrm-lm-logo--black{height:32px;width:auto}
.zrm-lm-lang{font-size:13px;color:#fff}.zrm-lm-lang span{opacity:.7;margin-inline:7px}
.zrm-lm-subscribe{height:38px;padding:0 17px;border:0;border-radius:4px;background:var(--zrm-lm-yellow);font-weight:800;color:#1d2025;cursor:pointer}
.zrm-lm-account-dot{width:22px;height:22px;border:1px solid rgba(255,255,255,.45);border-radius:50%;position:relative}.zrm-lm-account-dot:before{content:'';position:absolute;width:6px;height:6px;border:1px solid #fff;border-radius:50%;top:3px;left:7px}.zrm-lm-account-dot:after{content:'';position:absolute;width:10px;height:5px;border:1px solid #fff;border-bottom:0;border-radius:10px 10px 0 0;bottom:3px;left:5px}
.zrm-lm-header--compact .zrm-lm-header__top{min-height:74px;grid-template-columns:auto 1fr auto;padding:10px 30px}
.zrm-lm-header--compact .zrm-lm-header__tools{gap:18px}.zrm-lm-header--compact .zrm-lm-tool{flex-direction:row;min-width:auto;font-size:14px}
.zrm-lm-header--compact .zrm-lm-header__account{gap:18px}

/* NAV */
.zrm-lm-nav{background:var(--zrm-lm-night);color:#fff;border-bottom:1px solid rgba(255,255,255,.2)}
.zrm-lm-nav__row{width:min(var(--zrm-lm-content),calc(100% - 40px));margin:auto;display:flex;align-items:center;gap:19px;min-height:54px;overflow:auto;white-space:nowrap}
