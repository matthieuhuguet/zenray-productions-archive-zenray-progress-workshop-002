  -map "0:a:$TRACK_IDX" -vn \
  -c:a aac -ac 2 -b:a 160k \
  -movflags +frag_keyframe+empty_moov+default_base_moof \
  audio_${LANG}.mp4

# Text subtitles → WebVTT (direct)
