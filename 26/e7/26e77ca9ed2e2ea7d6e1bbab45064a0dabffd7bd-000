.zrm-lm-ticker__meta{font:800 12px/1.2 var(--zrm-lm-sans);margin-bottom:10px}.zrm-lm-ticker__live{color:#ef352f}.zrm-lm-ticker__title{font:700 15px/1.35 var(--zrm-lm-serif)}
.zrm-lm-ticker__more{display:grid;place-items:center}.zrm-lm-outline{height:36px;padding:0 17px;background:#fff;border:1px solid #cfd4db;border-radius:999px;color:#343b48;font-weight:700}

/* HOME HERO */
.zrm-lm-home{background:#fff}.zrm-lm-home__body{padding:30px 0 70px}
.zrm-lm-home-hero{display:grid;grid-template-columns:360px minmax(0,1fr);gap:40px;align-items:start}
.zrm-lm-live-badge{display:inline-flex;align-items:center;height:26px;padding:0 9px;border-radius:3px;background:var(--zrm-lm-red);color:#fff;font:800 12px/1 var(--zrm-lm-sans);margin-bottom:9px}.zrm-lm-live-badge:before{content:'';width:6px;height:6px;background:#fff;border-radius:50%;margin-right:6px}
.zrm-lm-home-hero__title{font:800 clamp(34px,3.2vw,48px)/1.04 var(--zrm-lm-serif);letter-spacing:-.025em;margin:0 0 30px;color:#242b39}
.zrm-lm-home-hero__update{font:700 16px/1.35 var(--zrm-lm-serif);margin:0 0 18px}.zrm-lm-home-hero__time{color:#d8322d;font-family:var(--zrm-lm-body);font-weight:800}
.zrm-lm-figure{margin:0}.zrm-lm-figure img{width:100%;height:auto}.zrm-lm-figure__caption{display:flex;justify-content:space-between;gap:18px;color:#5f6672;font-size:12px;padding-top:7px}
.zrm-lm-carousel{position:relative}.zrm-lm-carousel__controls{position:absolute;left:14px;right:14px;bottom:14px;display:flex;align-items:center;justify-content:space-between;color:#fff}.zrm-lm-carousel__left{display:flex;gap:8px}.zrm-lm-round{width:35px;height:35px;border:0;border-radius:50%;background:rgba(31,34,40,.72);color:#fff;font-size:24px}.zrm-lm-dots{display:flex;gap:7px;background:rgba(31,34,40,.68);padding:10px 14px;border-radius:999px}.zrm-lm-dots i{display:block;width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.45)}.zrm-lm-dots i.is-active{background:#fff}
.zrm-lm-link-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:52px;border-top:1px solid var(--zrm-lm-line)}
