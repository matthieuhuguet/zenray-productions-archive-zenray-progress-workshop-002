  --zrm-lm-sans:'Arial Narrow',Arial,Helvetica,sans-serif;
  --zrm-lm-body:Arial,Helvetica,sans-serif;
}
.zrm-lm,.zrm-lm *{box-sizing:border-box}
.zrm-lm{font-family:var(--zrm-lm-body);color:var(--zrm-lm-ink);background:var(--zrm-lm-bg);line-height:1.35}
.zrm-lm a{color:inherit;text-decoration:none}
.zrm-lm button,.zrm-lm input,.zrm-lm textarea{font:inherit}
.zrm-lm img{display:block;max-width:100%}
.zrm-lm .lm-inner{width:min(var(--zrm-lm-content),calc(100% - 40px));margin-inline:auto}
.zrm-lm .lm-wide{width:min(var(--zrm-lm-wide),calc(100% - 40px));margin-inline:auto}
.zrm-lm .lm-page{background:#fff;min-height:100vh}
.zrm-lm .lm-section-space{padding:32px 0}
.zrm-lm .lm-serif{font-family:var(--zrm-lm-serif)}
.zrm-lm .lm-kicker{font:800 12px/1.2 var(--zrm-lm-sans);text-transform:uppercase;letter-spacing:.055em;color:#717b8b;margin:0 0 9px}
.zrm-lm .lm-mark{display:inline-grid;place-items:center;width:15px;height:15px;margin-right:7px;background:var(--zrm-lm-yellow);color:#2d3037;font:900 9px/1 var(--zrm-lm-body);vertical-align:2px}
