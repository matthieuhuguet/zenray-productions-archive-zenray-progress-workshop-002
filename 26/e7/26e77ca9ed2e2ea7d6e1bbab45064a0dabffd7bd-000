.zrm-lm-icon-menu{width:16px;height:12px;border-top:2px solid currentColor;border-bottom:2px solid currentColor;position:relative}.zrm-lm-icon-menu:before{content:'';position:absolute;left:0;right:0;top:4px;border-top:2px solid currentColor}
.zrm-lm-icon-search{width:16px;height:16px;border:2px solid currentColor;border-radius:50%;position:relative;margin-right:5px}.zrm-lm-icon-search:after{content:'';position:absolute;width:7px;border-top:2px solid currentColor;transform:rotate(45deg);right:-5px;bottom:-2px}
.zrm-lm-topic-nav{background:var(--zrm-lm-night);color:#fff;border-bottom:1px solid rgba(255,255,255,.25)}
.zrm-lm-topic-nav__row{width:min(var(--zrm-lm-content),calc(100% - 40px));margin:auto;display:flex;gap:20px;align-items:center;min-height:52px;overflow:auto;white-space:nowrap;font:700 14px/1 var(--zrm-lm-sans)}
.zrm-lm-topic-nav__sep{opacity:.5}

/* TICKER */
