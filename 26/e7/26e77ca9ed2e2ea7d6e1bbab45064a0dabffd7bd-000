.zrm-lm-live{background:#f4f5f7}.zrm-lm-live-hero{background:var(--zrm-lm-night);color:#fff;padding:38px 0 46px}.zrm-lm-live-hero__top{display:flex;align-items:center;gap:11px;margin-bottom:18px}.zrm-lm-live-hero__updated{color:#b8bdc4;font-size:14px}.zrm-lm-live-hero__title{font:900 clamp(43px,4vw,61px)/1.03 var(--zrm-lm-sans);letter-spacing:-.035em;margin:0 0 20px;max-width:1050px}.zrm-lm-live-hero__dek{font:700 18px/1.38 var(--zrm-lm-body);max-width:930px;margin:0 0 18px}.zrm-lm-live-hero__byline{color:#b8bdc4}.zrm-lm-live-actions{display:flex;gap:13px;margin-top:19px}.zrm-lm-live-action{width:39px;height:39px;border-radius:50%;border:1px solid #68717c;background:transparent;color:#fff;font-size:19px}
.zrm-lm-live-media{background:var(--zrm-lm-night);padding-bottom:40px}.zrm-lm-live-media img{width:min(1185px,calc(100% - 40px));margin:auto;height:auto}
