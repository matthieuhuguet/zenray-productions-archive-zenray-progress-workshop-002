.zrm-lm-live-stream{display:grid;gap:22px}.zrm-lm-question-form,.zrm-lm-live-card{background:#fff;border:1px solid #e2e5e9;padding:28px 38px}.zrm-lm-question-form__title{font-weight:800;margin-bottom:22px}.zrm-lm-question-form textarea{width:100%;height:72px;resize:none;border:1px solid #929dac;padding:17px;color:#7e8794}.zrm-lm-question-thread{background:#fff;border:1px solid #e2e5e9;padding:30px 38px}.zrm-lm-question-thread__head{display:flex;justify-content:space-between;font:900 14px/1 var(--zrm-lm-sans);margin-bottom:25px}.zrm-lm-bubble{width:88%;margin:0 0 30px auto;background:#eef0f3;padding:15px 20px;border-radius:15px 15px 2px 15px;color:#505968}.zrm-lm-bubble__author{text-align:right;color:#788292;margin-top:-22px;margin-bottom:22px}
.zrm-lm-live-card__head{display:flex;justify-content:space-between;align-items:center;font:900 14px/1 var(--zrm-lm-sans);margin-bottom:28px}.zrm-lm-live-card__title{font:800 18px/1.25 var(--zrm-lm-body);margin:0 0 20px}.zrm-lm-live-card__body{font-size:17px;line-height:1.55;color:#4b5463}.zrm-lm-live-card__body p{margin:0 0 22px}
.zrm-lm-live-rail{display:grid;gap:24px}.zrm-lm-facts{display:grid;grid-template-columns:7px 1fr auto;background:#fff;box-shadow:0 4px 18px rgba(26,35,48,.04)}.zrm-lm-facts__bar{background:#d82d2d}.zrm-lm-facts__title{padding:25px 20px;color:#d82d2d;font:900 15px/1 var(--zrm-lm-sans)}.zrm-lm-facts__action{padding:25px 20px;color:#3778da}
.zrm-lm-live-rail-box{background:#fff;padding:21px;border:1px solid #e2e5e9}.zrm-lm-live-rail-title{font:900 18px/1 var(--zrm-lm-sans);text-transform:uppercase;border-bottom:1px solid #a9b1be;padding-bottom:9px;margin:0 0 19px}.zrm-lm-live-related{display:grid;gap:20px}.zrm-lm-live-related__item{display:grid;grid-template-columns:1fr 130px;gap:14px;padding-bottom:18px;border-bottom:1px solid var(--zrm-lm-line)}.zrm-lm-live-related__title{font:800 16px/1.25 var(--zrm-lm-serif);margin:0 0 12px}.zrm-lm-live-related__meta{font-size:12px;color:#788291}.zrm-lm-live-related img{width:130px;height:86px;object-fit:cover}.zrm-lm-context{font-size:16px;line-height:1.5;color:#5c6574}.zrm-lm-ad{height:305px;background:#e9ebef;position:relative}.zrm-lm-ad:before{content:'PUBLICITÉ';position:absolute;top:10px;left:0;right:0;text-align:center;font-size:9px;letter-spacing:.08em;color:#7f8794}

/* SECTION */
.zrm-lm-section-page{background:#fff}.zrm-lm-section-header{padding:48px 0 42px}.zrm-lm-section-header__title{font:900 clamp(48px,4.2vw,66px)/1 var(--zrm-lm-sans);margin:0 0 28px;color:#2c3444;letter-spacing:-.04em}.zrm-lm-tag-row{display:flex;gap:12px;overflow:auto;padding-bottom:15px}.zrm-lm-tag{flex:0 0 auto;min-height:48px;display:flex;align-items:center;padding:0 16px;border:1px solid #cbd1da;background:#fff;font-weight:700;font-size:13px}.zrm-lm-more-link{display:inline-block;color:#347bd3;margin-top:4px}
.zrm-lm-section-layout{display:grid;grid-template-columns:minmax(0,700px) 375px;gap:70px;padding:42px 0 80px;border-top:3px solid #344052}.zrm-lm-section-card{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:20px;padding:28px 0;border-bottom:1px solid var(--zrm-lm-line)}.zrm-lm-section-card__title{font:800 22px/1.14 var(--zrm-lm-serif);margin:0 0 12px}.zrm-lm-section-card__dek{font-size:15px;line-height:1.5;color:#555f6e}.zrm-lm-section-card__meta{font-size:12px;color:#7c8696;margin-top:12px}.zrm-lm-section-card img{width:190px;height:126px;object-fit:cover}

/* KIOSK */
.zrm-lm-kiosk{background:#fff}.zrm-lm-kiosk-head{height:64px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 20px;border-bottom:1px solid var(--zrm-lm-line)}.zrm-lm-kiosk-head__title{font:900 18px/1 var(--zrm-lm-sans);text-transform:uppercase}.zrm-lm-kiosk-head__actions{justify-self:end;display:flex;gap:14px;align-items:center}.zrm-lm-login{height:38px;padding:0 15px;border:0;border-radius:4px;background:#2b3441;color:#fff;font-weight:700}
