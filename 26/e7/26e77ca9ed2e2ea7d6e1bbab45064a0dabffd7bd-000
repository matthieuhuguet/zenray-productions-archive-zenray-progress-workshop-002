<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ZenRayMedia — Le Monde Final Theme</title><style>:root{
  --zrm-lm-bg:#f3f4f6;
  --zrm-lm-paper:#fff;
  --zrm-lm-ink:#202735;
  --zrm-lm-ink-soft:#4c5565;
  --zrm-lm-muted:#7d8798;
